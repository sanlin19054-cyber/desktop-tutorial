<?xml version="1.0" encoding="utf-8"?>
<!-- 方向鍵圓形按鈕：深色背景 + 霓虹青邊框，按下時填充霓虹青 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary"/>
            <stroke android:width="2dp" android:color="@color/primary_dark"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/bg_card"/>
            <stroke android:width="2dp" android:color="@color/text_disabled"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bg_card"/>
            <stroke android:width="2dp" android:color="@color/border"/>
        </shape>
    </item>
</selector>
