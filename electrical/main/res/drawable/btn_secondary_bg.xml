<?xml version="1.0" encoding="utf-8"?>
<!-- 次要按鈕：半透明霓虹青背景，按下時變實心 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary"/>
            <corners android:radius="@dimen/radius_button"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card"/>
            <stroke android:width="1dp" android:color="@color/text_disabled"/>
            <corners android:radius="@dimen/radius_button"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A00E0FF"/>
            <stroke android:width="1dp" android:color="@color/border"/>
            <corners android:radius="@dimen/radius_button"/>
        </shape>
    </item>
</selector>
