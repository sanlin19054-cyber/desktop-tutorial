<?xml version="1.0" encoding="utf-8"?>
<!-- 橫版遙控主頁（可下拉捲動 + 方向鍵在右端）：
     - 頂部狀態列（設備名/已發送/上次發送/連接按鈕）
     - 左欄：RX 顯示 + 模式按鈕 + 手動調試
     - 右欄：5 向方向鍵（按住式控制 + 心跳重發）
     外層 ScrollView 支援下拉，小螢幕也能看到所有按鍵 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- =========================================================== -->
        <!-- 1. 頂部狀態列（橫向緊湊） -->
        <!-- =========================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- 設備名稱 + 地址 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDeviceName"
                    style="@style/CardTitle"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="尚未選擇設備"/>

                <TextView
                    android:id="@+id/txtDeviceAddr"
                    style="@style/InfoLabel"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="—"/>
            </LinearLayout>

            <!-- 已發送次數（左上角計數器，含消抖） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="已發送次數"/>

                <TextView
                    android:id="@+id/txtSentCount"
                    style="@style/InfoValue"
                    android:text="0"/>
            </LinearLayout>

            <!-- 上次發送 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="上次發送"/>

                <TextView
                    android:id="@+id/txtLastSent"
                    style="@style/InfoValue"
                    android:text="—"/>
            </LinearLayout>

            <!-- 連線狀態 + 連接/斷開按鈕 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtConnState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="#1F94A3B8"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="未連接"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConnect"
                        style="@style/PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:textSize="12sp"
                        android:text="@string/label_connect"/>

                    <Button
                        android:id="@+id/btnDisconnect"
                        style="@style/PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_stop_bg"
                        android:textSize="12sp"
                        android:text="@string/label_disconnect"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- =========================================================== -->
        <!-- 2. 主內容（左：資訊+模式+手動  /  右：方向鍵） -->
        <!-- =========================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- 左欄：OLED 診斷提示 + TX（手機→小車）顯示 + RX（小車→手機）顯示 + 模式按鈕 + 手動調試 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:layout_marginEnd="4dp"
                android:orientation="vertical">

                <!-- OLED 檢查提示（解決用戶把 APP 端 RX 誤認為是固件 RX 的問題） -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1AE8325F"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="➊ 請看小車 OLED 第 2 行「RX:XX」判斷是否真的收到字節！\n➋ 按鍵時 XX 應從 00→01/02/03/04/05/06/07/08"
                    android:textColor="#FF5A8A"
                    android:textSize="10sp"/>

                <!-- TX：手機→小車 已發送（最後一次發送字節） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1600E0FF"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶ TX 手機→小車："
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtTxLastSent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- RX：小車→手機 回傳（固件不會主動回傳，所以恆顯示等待） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_card"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◀ RX 小車→手機："
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtRxBuf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="(固件默認不回傳，此欄為空屬正常)"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- 模式切換 2x2 -->
                <TextView
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="模式切換"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="true">

                    <Button
                        android:id="@+id/btnAvoid"
                        style="@style/SecondaryButton"
                        android:layout_row="0"
                        android:layout_column="0"
                        android:layout_columnWeight="1"
                        android:layout_height="48dp"
                        android:textSize="12sp"
                        android:text="避障\n(0x05)"/>

                    <Button
                        android:id="@+id/btnTrack"
                        style="@style/SecondaryButton"
                        android:layout_row="0"
                        android:layout_column="1"
                        android:layout_columnWeight="1"
                        android:layout_height="48dp"
                        android:textSize="12sp"
                        android:text="循跡\n(0x06)"/>

                    <Button
                        android:id="@+id/btnLedOn"
                        style="@style/SecondaryButton"
                        android:layout_row="1"
                        android:layout_column="0"
                        android:layout_columnWeight="1"
                        android:layout_height="48dp"
                        android:textSize="12sp"
                        android:text="開燈\n(0x07)"/>

                    <Button
                        android:id="@+id/btnLedOff"
                        style="@style/SecondaryButton"
                        android:layout_row="1"
                        android:layout_column="1"
                        android:layout_columnWeight="1"
                        android:layout_height="48dp"
                        android:textSize="12sp"
                        android:text="關燈\n(0x08)"/>
                </GridLayout>

                <!-- 手動調試卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_weight="1"
                            android:text="手動調試"/>

                        <TextView
                            android:id="@+id/txtModeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card"
                            android:backgroundTint="#1A00E0FF"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="HEX"
                            android:textColor="@color/primary"
                            android:textSize="11sp"/>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/editInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="輸入 HEX，例如 01 或 01 02"
                        android:inputType="text|textCapCharacters"
                        android:maxLines="1"
                        android:padding="8dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="13sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEmergencyStop"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_stop_bg"
                            android:text="緊急停車\n0x00"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"/>

                        <Button
                            android:id="@+id/btnSend"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_primary_bg"
                            android:text="@string/label_send"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 右欄：5 向方向鍵（按習慣放在屏幕右端） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center_horizontal">

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:useDefaultMargins="true">

                    <Button
                        android:id="@+id/btnUp"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_row="0"
                        android:layout_column="1"
                        android:background="@drawable/btn_direction_bg"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:text="▲"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnLeft"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_row="1"
                        android:layout_column="0"
                        android:background="@drawable/btn_direction_bg"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:text="◀"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_row="1"
                        android:layout_column="1"
                        android:background="@drawable/btn_stop_bg"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:text="STOP"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnRight"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_row="1"
                        android:layout_column="2"
                        android:background="@drawable/btn_direction_bg"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnDown"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_row="2"
                        android:layout_column="1"
                        android:background="@drawable/btn_direction_bg"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:text="▼"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold"/>
                </GridLayout>

                <TextView
                    style="@style/InfoLabel"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="方向鍵按住運動\n鬆開停止"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
